{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'email'])"
      }
    },
    "lists": {
      "$listId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || data.child('isPublic').val() === true)",
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['userId', 'name'])"
      }
    },
    "entries": {
      "$entryId": {
        ".read": "auth != null && root.child('lists').child(data.child('listId').val()).child('userId').val() === auth.uid",
        ".write": "auth != null && root.child('lists').child(data.child('listId').val()).child('userId').val() === auth.uid",
        ".validate": "newData.hasChildren(['listId', 'movieId'])"
      }
    }
  }
} 